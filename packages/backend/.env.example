# CivicFix Backend Environment Configuration Example
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# SQLite database for zero-config local run
# For production PostgreSQL: DATABASE_URL="postgresql://user:pass@localhost:5432/civicfix?schema=public"
DATABASE_URL="file:./dev.db"

# Session Security
SESSION_SECRET="civicfix-demo-secret-key-32chars-min-change-prod-2026"

# Google Gemini Vision
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Cloudinary Production Image Storage (Render Free Plan - Persistent CDN)
# Get credentials from your Cloudinary Dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth2 Authentication
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173, http://localhost:3001
# Authorized redirect URIs: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# Geocoding
GEOCODING_ENABLED="true"

# SMTP Mailer (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
